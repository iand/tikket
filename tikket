cmd_check() {
    local -a files=("$TICKETS_DIR"/*.md)
    if [[ ! -e "${files[0]}" ]]; then
        echo "No problems found"
        return 0
    fi

    awk -v valid_statuses="$VALID_STATUSES" -v valid_types="$VALID_TYPES" -v valid_resolutions="$VALID_RESOLUTIONS" '
    BEGIN {
        FS=": "
        n = split(valid_statuses, a, " "); for (i = 1; i <= n; i++) ok_status[a[i]] = 1
        n = split(valid_types, a, " "); for (i = 1; i <= n; i++) ok_type[a[i]] = 1
        n = split(valid_resolutions, a, " "); for (i = 1; i <= n; i++) ok_res[a[i]] = 1
    }
    FNR==1 {
        if (prev_file) finish()
        fm=0; id=""; status=""; type=""; priority=""; deps=""; links=""; parent=""; resolution=""; closed=""
        name = FILENAME; sub(/.*\//, "", name); sub(/\.md$/, "", name)
        names[++nfiles] = name
        exists[name] = 1
        prev_file = FILENAME
        if ($0 != "---") { report(name, "missing frontmatter (first line is not ---)"); fm = 2 }
    }
    /^---$/ && fm < 2 { fm++; next }
    fm == 1 && /^id:/ { id = $2 }
    fm == 1 && /^status:/ { status = $2 }
    fm == 1 && /^type:/ { type = $2 }
    fm == 1 && /^priority:/ { priority = $2 }
    fm == 1 && /^deps:/ { deps = $2; gsub(/[\[\] ]/, "", deps) }
    fm == 1 && /^links:/ { links = $2; gsub(/[\[\] ]/, "", links) }
    fm == 1 && /^parent:/ { parent = $2 }
    fm == 1 && /^resolution:/ { resolution = $2 }
    fm == 1 && /^closed:/ { closed = $2 }
    function report(who, msg) { print who ": " msg; problems++ }
    function finish() {
        if (fm == 1) report(name, "unterminated frontmatter (no closing ---)")
        if (id == "") report(name, "missing id field")
        else if (id != name) report(name, "id field " id " does not match filename")
        if (id != "" && (id in owner)) report(name, "duplicate id " id " (also in " owner[id] ".md)")
        if (id != "") owner[id] = name

        if (status == "") report(name, "missing status field")
        else if (!(status in ok_status)) report(name, "invalid status " status)
        if (type != "" && !(type in ok_type)) report(name, "invalid type " type)
        if (priority != "" && priority !~ /^[0-4]$/) report(name, "invalid priority " priority)
        if (resolution != "" && !(resolution in ok_res)) report(name, "invalid resolution " resolution)
        if (status != "closed" && resolution != "") report(name, "resolution set on ticket that is not closed")
        if (status != "closed" && closed != "") report(name, "closed timestamp set on ticket that is not closed")

        all_deps[name] = deps
        all_links[name] = links
        parents[name] = parent
    }
    function has(list, item,    i, n, arr) {
        n = split(list, arr, ",")
        for (i = 1; i <= n; i++) if (arr[i] == item) return 1
        return 0
    }
    END {
        if (prev_file) finish()

        for (k = 1; k <= nfiles; k++) {
            name = names[k]

            n = split(all_deps[name], arr, ",")
            for (i = 1; i <= n; i++) {
                d = arr[i]
                if (d == "") continue
                if (d == name) report(name, "depends on itself")
                else if (!(d in exists)) report(name, "dependency " d " does not exist")
            }

            n = split(all_links[name], arr, ",")
            for (i = 1; i <= n; i++) {
                l = arr[i]
                if (l == "") continue
                if (l == name) report(name, "links to itself")
                else if (!(l in exists)) report(name, "link " l " does not exist")
                else if (!has(all_links[l], name)) report(name, "link to " l " is not reciprocated")
            }

            p = parents[name]
            if (p != "") {
                if (p == name) report(name, "is its own parent")
                else if (!(p in exists)) report(name, "parent " p " does not exist")
                else {
                    # Walk up the parent chain looking for a loop back to this ticket
                    steps = 0
                    while (p != "" && p != name && steps++ < nfiles) p = parents[p]
                    if (p == name) report(name, "parent chain forms a cycle")
                }
            }
        }

        if (problems == 0) { print "No problems found"; exit 0 }
        print problems " problem(s) found"
        exit 1
    }
    ' "${files[@]}"
}

